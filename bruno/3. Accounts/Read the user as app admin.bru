meta {
  name: Read the user as app admin
  type: http
  seq: 5
}

get {
  url: {{user_identity_url}}/api/v1/user/{{user_id}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{admin_access_token}}
}

tests {
  test("User details - Status is 200", () => {
      expect(res.getStatus()).to.equal(200);
      expect(res.getBody().user.userName).to.be.eql(bru.getVar("user_name"));
  });
}
