meta {
  name: Log in with a wrong password - 401
  type: http
  seq: 4
}

post {
  url: {{user_identity_url}}/api/v1/user/login
  body: json
  auth: none
}

headers {
  X-App-Name: {{app_name}}
}

body:json {
  {
    "userName": "{{user_name}}",
    "password": "Wr0ng@P@ss"
  }
}

tests {
  test("Wrong password - Status is 401", () => {
      expect(res.getStatus()).to.equal(401);
  });
}
