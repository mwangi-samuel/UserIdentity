meta {
  name: Login global admin
  type: http
  seq: 2
}

post {
  url: {{user_identity_url}}/api/v1/user/login
  body: json
  auth: none
}

headers {
  X-App-Name: {{app_name}}
}

body:json {
  {
    "userName": "{{global_admin_user_name}}",
    "password": "{{global_admin_password}}"
  }
}

tests {
  test("Login global admin - Status is 200", () => {
      expect(res.getStatus()).to.equal(200);
      expect(res.getBody().isConfirmed, "run the SQL commands first").to.be.true;
      const roles = [].concat(require("jsonwebtoken").decode(res.getBody().userToken.accessToken.token).roles || []);
      expect(roles, "run the SQL commands first").to.include("global:admin");
      expect(roles, "a global admin isn't an app admin").to.not.include(`${bru.interpolate("{{app_name}}")}:admin`);

      bru.setVar("global_admin_access_token", res.getBody().userToken.accessToken.token);
  });
}
