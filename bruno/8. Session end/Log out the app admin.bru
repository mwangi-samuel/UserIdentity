meta {
  name: Log out the app admin
  type: http
  seq: 1
}

post {
  url: {{user_identity_url}}/api/v1/user/logout
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{admin_access_token}}
}

body:json {
  {
    "refreshToken": "{{admin_refresh_token}}"
  }
}

tests {
  test("Logout - Status is 200", () => {
      expect(res.getStatus()).to.equal(200);
  });
}
