meta {
  name: Get the signing keys (anonymous)
  type: http
  seq: 2
}

get {
  url: {{user_identity_url}}/api/v1/jwks/keys
  body: none
  auth: none
}

tests {
  test("Signing keys - Status is 200", () => {
      expect(res.getStatus()).to.equal(200);
      const keys = res.getBody().keys;
      expect(keys).to.not.be.empty;
      expect(keys[0]).to.include({ alg: "EdDSA", kty: "OKP", crv: "Ed25519" });
      expect(keys[0].kid).to.not.be.empty;
      expect(keys[0].d, "only the public key is published").to.be.undefined;
  });
}
