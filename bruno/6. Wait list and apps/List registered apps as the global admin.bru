meta {
  name: List registered apps as the global admin
  type: http
  seq: 5
}

get {
  url: {{user_identity_url}}/api/v1/registered-app
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{global_admin_access_token}}
}

tests {
  test("Registered apps - Status is 200", () => {
      expect(res.getStatus()).to.equal(200);
      expect(res.getBody().registeredApps.map(a => a.appName.toLowerCase())).to.include(bru.interpolate("{{app_name}}").toLowerCase());
  });
}
