meta {
  name: List app entities
  type: http
  seq: 3
}

get {
  url: {{user_identity_url}}/api/v1/app-entity
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{admin_access_token}}
}

tests {
  test("App entities - Status is 200", () => {
      expect(res.getStatus()).to.equal(200);
      const entities = res.getBody().appEntities;
      expect(entities.map(e => e.resourceName)).to.include("useridentity-invite-code");
      expect(entities.every(e => e.currentService === "useridentity")).to.be.true;
  });
}
