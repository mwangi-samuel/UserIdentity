meta {
  name: Request a password reset
  type: http
  seq: 1
}

post {
  url: {{user_identity_url}}/api/v1/user/reset-password
  body: json
  auth: none
}

headers {
  X-App-Name: {{app_name}}
}

body:json {
  {
    "userName": "{{user_email}}"
  }
}

tests {
  test("Reset password - Status is 200", () => {
      expect(res.getStatus()).to.equal(200);
      const details = res.getBody().resetPasswordDetails;
      expect(details.resetRequestId).to.not.be.empty;
      bru.setVar("reset_request_id", details.resetRequestId);
  });
}
