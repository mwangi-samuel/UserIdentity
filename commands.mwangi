# Run tests with Coverage (Microsoft Testing Platform + coverlet.MTP)
dotnet test --project UserIdentity.UnitTests/UserIdentity.UnitTests.csproj --coverlet
# Generate Coverage Report
reportgenerator -reports:"Path\To\TestProject\TestResults\coverage.cobertura.*.xml" -targetdir:"coveragereport" -reporttypes:Html

# Adding Migration (dotnet-ef is pinned in dotnet-tools.json)
dotnet tool restore
dotnet ef migrations add MigrationName --project UserIdentity
