@UserIdentity_HostAddress = http://localhost:5050
@ApiKey = TestApiKey-For-Local-Use-Only-0123456789
@AppName = testapp
@AdminUserName = admin
@AdminPassword = Adm1n@P@ss
@GlobalAdminUserName = globaladmin
@GlobalAdminPassword = Gl0b@lAdm1n
@UserPassword = P@ssW1rd
@NewUserPassword = N3w@P@ssW1rd

GET {{UserIdentity_HostAddress}}/health

###

GET {{UserIdentity_HostAddress}}/openapi/v1.json

###

GET {{UserIdentity_HostAddress}}/api/v1/jwks/keys

###

# up.ps1 registers both admins and gives them their roles
# @name adminLogin
POST {{UserIdentity_HostAddress}}/api/v1/user/login
X-Api-Key: {{ApiKey}}
X-App-Name: {{AppName}}
Content-Type: application/json

{
  "userName": "{{AdminUserName}}",
  "password": "{{AdminPassword}}"
}

###

# @name globalAdminLogin
POST {{UserIdentity_HostAddress}}/api/v1/user/login
X-Api-Key: {{ApiKey}}
X-App-Name: {{AppName}}
Content-Type: application/json

{
  "userName": "{{GlobalAdminUserName}}",
  "password": "{{GlobalAdminPassword}}"
}

###

# @name user
POST {{UserIdentity_HostAddress}}/api/v1/user/register
X-Api-Key: {{ApiKey}}
X-App-Name: {{AppName}}
Content-Type: application/json

{
  "firstName": "Test",
  "lastName": "User",
  "userName": "user{{$timestamp}}",
  "userEmail": "user{{$timestamp}}@example.com",
  "userPassword": "{{UserPassword}}"
}

###

GET {{UserIdentity_HostAddress}}/api/v1/user/{{user.response.body.$.user.id}}
X-Api-Key: {{ApiKey}}
Authorization: Bearer {{adminLogin.response.body.$.userToken.accessToken.token}}

###

# @name role
POST {{UserIdentity_HostAddress}}/api/v1/role
X-Api-Key: {{ApiKey}}
Authorization: Bearer {{adminLogin.response.body.$.userToken.accessToken.token}}
Content-Type: application/json

{
  "roleName": "{{AppName}}:editor{{$timestamp}}"
}

###

GET {{UserIdentity_HostAddress}}/api/v1/role
X-Api-Key: {{ApiKey}}
Authorization: Bearer {{adminLogin.response.body.$.userToken.accessToken.token}}

###

GET {{UserIdentity_HostAddress}}/api/v1/role/{{role.response.body.$.role.id}}
X-Api-Key: {{ApiKey}}
Authorization: Bearer {{adminLogin.response.body.$.userToken.accessToken.token}}

###

POST {{UserIdentity_HostAddress}}/api/v1/role/claim
X-Api-Key: {{ApiKey}}
Authorization: Bearer {{adminLogin.response.body.$.userToken.accessToken.token}}
Content-Type: application/json

{
  "roleId": "{{role.response.body.$.role.id}}",
  "resource": "catalog-product",
  "action": "read"
}

###

GET {{UserIdentity_HostAddress}}/api/v1/role/claim/{{role.response.body.$.role.id}}
X-Api-Key: {{ApiKey}}
Authorization: Bearer {{adminLogin.response.body.$.userToken.accessToken.token}}

###

POST {{UserIdentity_HostAddress}}/api/v1/role/user
X-Api-Key: {{ApiKey}}
Authorization: Bearer {{adminLogin.response.body.$.userToken.accessToken.token}}
Content-Type: application/json

{
  "userId": "{{user.response.body.$.user.id}}",
  "roleId": "{{role.response.body.$.role.id}}"
}

###

GET {{UserIdentity_HostAddress}}/api/v1/role/user/{{user.response.body.$.user.id}}
X-Api-Key: {{ApiKey}}
Authorization: Bearer {{adminLogin.response.body.$.userToken.accessToken.token}}

###

# @name invite
POST {{UserIdentity_HostAddress}}/api/v1/invite-code
X-Api-Key: {{ApiKey}}
Authorization: Bearer {{adminLogin.response.body.$.userToken.accessToken.token}}
Content-Type: application/json

{
  "inviteCode": "INVITE{{$timestamp}}",
  "userEmail": "invitee{{$timestamp}}@example.com",
  "role": "{{role.response.body.$.role.name}}"
}

###

GET {{UserIdentity_HostAddress}}/api/v1/invite-code?page=1&pageSize=50&search=invitee&applied=false
X-Api-Key: {{ApiKey}}
Authorization: Bearer {{adminLogin.response.body.$.userToken.accessToken.token}}

###

GET {{UserIdentity_HostAddress}}/api/v1/invite-code/{{invite.response.body.$.inviteCode.id}}
X-Api-Key: {{ApiKey}}
Authorization: Bearer {{adminLogin.response.body.$.userToken.accessToken.token}}

###

GET {{UserIdentity_HostAddress}}/api/v1/invite-code/email/{{invite.response.body.$.inviteCode.userEmail}}
X-Api-Key: {{ApiKey}}
Authorization: Bearer {{adminLogin.response.body.$.userToken.accessToken.token}}

###

GET {{UserIdentity_HostAddress}}/api/v1/invite-code
X-Api-Key: {{ApiKey}}
X-App-Name: {{AppName}}
Authorization: Bearer {{globalAdminLogin.response.body.$.userToken.accessToken.token}}

###

POST {{UserIdentity_HostAddress}}/api/v1/user/register
X-Api-Key: {{ApiKey}}
X-App-Name: {{AppName}}
Content-Type: application/json

{
  "firstName": "Invited",
  "lastName": "User",
  "userName": "invitee{{$timestamp}}",
  "userEmail": "{{invite.response.body.$.inviteCode.userEmail}}",
  "userPassword": "{{UserPassword}}",
  "inviteCode": "{{invite.response.body.$.inviteCode.inviteCode}}"
}

###

# @name unusedInvite
POST {{UserIdentity_HostAddress}}/api/v1/invite-code
X-Api-Key: {{ApiKey}}
Authorization: Bearer {{adminLogin.response.body.$.userToken.accessToken.token}}
Content-Type: application/json

{
  "inviteCode": "UNUSED{{$timestamp}}",
  "userEmail": "unused{{$timestamp}}@example.com"
}

###

DELETE {{UserIdentity_HostAddress}}/api/v1/invite-code/{{unusedInvite.response.body.$.inviteCode.id}}
X-Api-Key: {{ApiKey}}
Authorization: Bearer {{adminLogin.response.body.$.userToken.accessToken.token}}

###

# @name waitList
POST {{UserIdentity_HostAddress}}/api/v1/wait-list
X-Api-Key: {{ApiKey}}
X-App-Name: {{AppName}}
Content-Type: application/json

{
  "userEmail": "waiting{{$timestamp}}@example.com"
}

###

GET {{UserIdentity_HostAddress}}/api/v1/wait-list/{{waitList.response.body.$.waitList.id}}
X-Api-Key: {{ApiKey}}
Authorization: Bearer {{adminLogin.response.body.$.userToken.accessToken.token}}

###

GET {{UserIdentity_HostAddress}}/api/v1/wait-list/email/{{waitList.response.body.$.waitList.userEmail}}
X-Api-Key: {{ApiKey}}
Authorization: Bearer {{adminLogin.response.body.$.userToken.accessToken.token}}

###

GET {{UserIdentity_HostAddress}}/api/v1/app-entity
X-Api-Key: {{ApiKey}}
Authorization: Bearer {{adminLogin.response.body.$.userToken.accessToken.token}}

###

GET {{UserIdentity_HostAddress}}/api/v1/registered-app
X-Api-Key: {{ApiKey}}
Authorization: Bearer {{globalAdminLogin.response.body.$.userToken.accessToken.token}}

###

# @name registeredApp
POST {{UserIdentity_HostAddress}}/api/v1/registered-app
X-Api-Key: {{ApiKey}}
Authorization: Bearer {{globalAdminLogin.response.body.$.userToken.accessToken.token}}
Content-Type: application/json

{
  "appName": "demoapp{{$timestamp}}",
  "baseUrl": "http://localhost:3001",
  "appSecretKey": "An0therS3cret-For-Local-Use-Only-012345",
  "requireInviteCode": true
}

###

GET {{UserIdentity_HostAddress}}/api/v1/registered-app/{{registeredApp.response.body.$.registeredApp.id}}
X-Api-Key: {{ApiKey}}
Authorization: Bearer {{globalAdminLogin.response.body.$.userToken.accessToken.token}}

###

GET {{UserIdentity_HostAddress}}/api/v1/registered-app/name/{{registeredApp.response.body.$.registeredApp.appName}}
X-Api-Key: {{ApiKey}}
Authorization: Bearer {{globalAdminLogin.response.body.$.userToken.accessToken.token}}

###

PUT {{UserIdentity_HostAddress}}/api/v1/registered-app/{{registeredApp.response.body.$.registeredApp.id}}
X-Api-Key: {{ApiKey}}
Authorization: Bearer {{globalAdminLogin.response.body.$.userToken.accessToken.token}}
Content-Type: application/json

{
  "appName": "{{registeredApp.response.body.$.registeredApp.appName}}",
  "baseUrl": "http://localhost:3001",
  "requireInviteCode": false,
  "description": "A demo app"
}

###

DELETE {{UserIdentity_HostAddress}}/api/v1/registered-app/{{registeredApp.response.body.$.registeredApp.id}}
X-Api-Key: {{ApiKey}}
Authorization: Bearer {{globalAdminLogin.response.body.$.userToken.accessToken.token}}

###

